{
  "name": "@minhspark/codex-mcp-bridge",
  "version": "1.25.2",
  "description": "Connect Claude, Codex, and Antigravity through MCP, with native Desktop handoffs and bridge-owned Antigravity CLI sessions.",
  "keywords": [
    "mcp",
    "codex",
    "claude-code",
    "claude-desktop",
    "app-server",
    "antigravity",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Bui Dang Minh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buidangminh23/codex-mcp-bridge.git"
  },
  "homepage": "https://github.com/buidangminh23/codex-mcp-bridge#readme",
  "bugs": {
    "url": "https://github.com/buidangminh23/codex-mcp-bridge/issues"
  },
  "type": "module",
  "bin": {
    "codex-mcp-bridge": "src/codex-bridge-launcher.mjs",
    "claude-mcp-bridge": "src/claude-bridge-launcher.mjs",
    "antigravity-mcp-bridge": "src/antigravity-bridge.mjs",
    "antigravity-mcp-bridge-install": "scripts/install-antigravity-bridge.mjs",
    "codex-mcp-bridge-install": "scripts/install-claude-desktop.mjs",
    "codex-bridge-code-install": "scripts/install-claude-code.mjs",
    "codex-bridge-setup": "scripts/setup.mjs",
    "bridge-projects": "scripts/bridge-projects.mjs",
    "claude-mcp-bridge-install": "scripts/install-codex-mcp.mjs",
    "codex-native-relay": "src/native-relay-launcher.mjs",
    "codex-native-relay-install": "scripts/install-native-relay.mjs",
    "codex-npm-footer-install": "scripts/install-npm-footer.mjs",
    "codex-full-access": "scripts/repair-codex-access.mjs",
    "codex-sites-connector": "src/sites-connector.mjs"
  },
  "files": [
    "src",
    "scripts",
    "!scripts/run-tests.mjs",
    "skills",
    "assets",
    "plugin.json",
    "mcp.json",
    ".codex-plugin",
    ".mcp.json",
    "glama.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/daily-handoffs.md",
    "docs/new-windows-setup.md",
    "docs/new-macos-setup.md",
    "docs/project-onboarding.md",
    "docs/desktop-handoff-design.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs --postinstall",
    "setup": "node scripts/setup.mjs",
    "analytics": "node scripts/collect-repo-analytics.mjs",
    "analytics:publish": "node scripts/publish-repo-analytics.mjs",
    "start": "node src/codex-bridge-launcher.mjs",
    "claude-bridge": "node src/claude-bridge-launcher.mjs",
    "antigravity-bridge": "node src/antigravity-bridge.mjs",
    "install:antigravity": "node scripts/install-antigravity-bridge.mjs",
    "app-server": "codex app-server --listen ws://127.0.0.1:8791",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "check:claude": "node scripts/check-claude-bridge.mjs",
    "smoke": "node scripts/smoke.mjs",
    "install:desktop": "node scripts/install-claude-desktop.mjs",
    "install:codex": "node scripts/install-codex-mcp.mjs",
    "uninstall:codex": "node scripts/install-codex-mcp.mjs --remove",
    "install:relay": "node scripts/install-native-relay.mjs",
    "uninstall:relay": "node scripts/install-native-relay.mjs --remove",
    "install:agent": "node scripts/install-launch-agent.mjs",
    "install:footer": "node scripts/install-npm-footer.mjs",
    "uninstall:footer": "node scripts/install-npm-footer.mjs --remove",
    "uninstall:agent": "node scripts/install-launch-agent.mjs --uninstall",
    "version": "node scripts/sync-version.mjs && git add src/index.mjs src/claude-bridge.mjs src/native-relay-companion.mjs scripts/install-native-relay.mjs .codex-plugin/plugin.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
